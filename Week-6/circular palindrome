class Result {

    public static List<Integer> circularPalindromes(String s) {

        int n = s.length();

        // We use s + s, but the last character is not needed twice.
        String t = s + s.substring(0, n - 1);

        int len = t.length();

        /*
         * Manacher arrays:
         * odd[i]  = radius of odd palindrome centered at i
         * even[i] = radius of even palindrome centered between i-1 and i
         */
        int[] odd = new int[len];
        int[] even = new int[len];

        // -------------------------
        // Odd length palindromes
        // -------------------------
        int l = 0;
        int r = -1;

        for (int i = 0; i < len; i++) {

            int k = (i > r) ? 1 : Math.min(odd[l + r - i], r - i + 1);

            while (i - k >= 0 &&
                   i + k < len &&
                   t.charAt(i - k) == t.charAt(i + k)) {
                k++;
            }

            odd[i] = k;

            if (i + k - 1 > r) {
                l = i - k + 1;
                r = i + k - 1;
            }
        }

        // -------------------------
        // Even length palindromes
        // -------------------------
        l = 0;
        r = -1;

        for (int i = 0; i < len; i++) {

            int k = (i > r) ? 0 : Math.min(even[l + r - i + 1], r - i + 1);

            while (i - k - 1 >= 0 &&
                   i + k < len &&
                   t.charAt(i - k - 1) == t.charAt(i + k)) {
                k++;
            }

            even[i] = k;

            if (i + k - 1 > r) {
                l = i - k;
                r = i + k - 1;
            }
        }

        /*
         * answer[start] = longest palindrome
         * contained in rotation starting at 'start'.
         */
        int[] answer = new int[n];

        Arrays.fill(answer, 1);

        /*
         * Every palindrome can contribute to several rotations.
         *
         * For simplicity, process every possible palindrome center
         * and every useful radius.
         */
        for (int center = 0; center < len; center++) {

            // Odd palindrome
            int maxRadius = odd[center];

            for (int radius = maxRadius; radius >= 1; radius--) {

                int palindromeLength = 2 * radius - 1;

                if (palindromeLength > n) {
                    continue;
                }

                int start = center - radius + 1;

                for (int rotation = 0; rotation < n; rotation++) {

                    int windowStart = rotation;
                    int windowEnd = rotation + n - 1;

                    int palindromeStart = start;
                    int palindromeEnd = start + palindromeLength - 1;

                    if (palindromeStart >= windowStart &&
                        palindromeEnd <= windowEnd) {

                        answer[rotation] =
                            Math.max(answer[rotation], palindromeLength);
                    }
                }
            }

            // Even palindrome
            maxRadius = even[center];

            for (int radius = maxRadius; radius >= 1; radius--) {

                int palindromeLength = 2 * radius;

                if (palindromeLength > n) {
                    continue;
                }

                int palindromeStart = center - radius;
                int palindromeEnd = center + radius - 1;

                for (int rotation = 0; rotation < n; rotation++) {

                    int windowStart = rotation;
                    int windowEnd = rotation + n - 1;

                    if (palindromeStart >= windowStart &&
                        palindromeEnd <= windowEnd) {

                        answer[rotation] =
                            Math.max(answer[rotation], palindromeLength);
                    }
                }
            }
        }

        List<Integer> result = new ArrayList<>();

        for (int value : answer) {
            result.add(value);
        }

        return result;
    }
}