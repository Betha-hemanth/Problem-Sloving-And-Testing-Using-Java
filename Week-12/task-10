import java.util.*;

class Product {
    int id;
    String name;
    int stock;
    double price;

    Product(int id, String name, int stock, double price) {
        this.id = id;
        this.name = name;
        this.stock = stock;
        this.price = price;
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        Map<Integer, Product> products = new HashMap<>();

        for (int i = 0; i < n; i++) {
            int id = sc.nextInt();
            String name = sc.next();
            int stock = sc.nextInt();
            double price = sc.nextDouble();

            products.put(id, new Product(id, name, stock, price));
        }

        // 1. Update stock after sales
        int id = sc.nextInt();
        int sold = sc.nextInt();

        Product p = products.get(id);

        if (p != null && sold >= 0 && sold <= p.stock) {
            p.stock -= sold;
        } else {
            System.out.println("Invalid product ID or quantity");
        }

        // 2. Find products below the stock threshold
        int threshold = sc.nextInt();

        System.out.println("Low Stock Products:");
        for (Product product : products.values()) {
            if (product.stock < threshold) {
                System.out.println(product.id + " " +
                    product.name + " " + product.stock);
            }
        }

        // 3. Display products sorted by remaining stock
        List<Product> list = new ArrayList<>(products.values());

        list.sort(Comparator.comparingInt(product -> product.stock));

        System.out.println("Products Sorted by Stock:");
        for (Product product : list) {
            System.out.println(product.id + " " +
                product.name + " " + product.stock + " " +
                product.price);
        }

        // 4. Retrieve a product using its ID
        int searchId = sc.nextInt();
        Product result = products.get(searchId);

        if (result != null) {
            System.out.println("Product Found: " + result.name +
                " " + result.stock + " " + result.price);
        } else {
            System.out.println("Product not found");
        }

        sc.close();
    }
}
